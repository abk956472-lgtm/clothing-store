from fastapi import FastAPI
from pydantic import BaseModel
from datetime import datetime

app = FastAPI(
    title="DRAGON AI CORE",
    version="20.0"
)

class ChatRequest(BaseModel):
    message: str

@app.get("/")
def root():
    return {
        "system": "DRAGON AI CORE",
        "version": "20.0",
        "status": "online",
        "message": "DRAGON AI CORE is running",
        "time": datetime.utcnow().isoformat()
    }

@app.get("/health")
def health():
    return {
        "status": "healthy",
        "core": "DRAGON AI CORE",
        "version": "20.0"
    }

@app.post("/chat")
def chat(request: ChatRequest):
    return {
        "core": "DRAGON AI CORE",
        "message": request.message,
        "response": "DRAGON AI CORE received your message."
    }
